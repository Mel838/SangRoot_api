datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  // This generates TypeScript code that matches your database
}

// ============================================
// ENUMS (Predefined Lists of Values)
// ============================================

enum UserRole {
  HOSPITAL // Can invite doctors, request blood, register donors
  BLOOD_BANK // Can register donors only
  DOCTOR // Can request blood only
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Gender {
  MALE
  FEMALE
}

enum CameroonRegion {
  ADAMAWA
  CENTRE
  EAST
  FAR_NORTH
  LITTORAL
  NORTH
  NORTH_WEST
  WEST
  SOUTH
  SOUTH_WEST
}

enum RequestStatus {
  PENDING // Just created
  IN_PROGRESS // AI agent is searching
  FULFILLED // Donor found
  CANCELLED // Requester cancelled
  EXPIRED // No donor found in time
}

enum RequestUrgency {
  CRITICAL // Life-threatening
  URGENT // Needed within hours
  ROUTINE // Planned procedure
}

enum DonorAvailability {
  AVAILABLE
  UNAVAILABLE
  CONDITIONAL
  NO_RESPONSE
}

enum DonorConversationState {
  ONBOARDING // First conversation in progress
  IDLE // No active outreach
  IN_OUTREACH // Currently being contacted for a blood request
  OPTED_OUT // Donor requested removal — never contact again
}

enum BloodBankConversationState {
  IDLE
  IN_OUTREACH
}

enum OutreachTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

// ============================================
// USER AUTHENTICATION & PROFILES
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String? // Null for Google-only accounts
  role         UserRole
  isActive     Boolean  @default(true)
  googleId     String?  @unique
  authProvider String   @default("local") // "local" | "google"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships (one user can be one of these)
  hospital  Hospital?
  bloodBank BloodBank?
  doctor    Doctor?

  // All blood requests made by this user
  bloodRequests BloodRequest[]
  refreshTokens RefreshToken[]

  @@map("users") // Table name in database
}

// Refresh tokens for long-lived sessions. Tokens are stored hashed; cookie contains id.token
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Hospital Profile (extends User)
model Hospital {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  phone String @unique

  // Location — Cameroon administrative structure
  region        CameroonRegion
  town          String // e.g. "Yaoundé", "Douala", "Bafoussam"
  neighbourhood String? // Quartier e.g. "Ngousso", "Bonamoussadi"
  address       String? // Landmark-based detail e.g. "En face du marché Mokolo"

  // Optional precise location
  latitude  Float?
  longitude Float?

  // Official registration
  licenseNumber String? // Numéro d'agrément — issued by Ministère de la Santé Publique

  // Relationships
  doctors          Doctor[]
  invites          HospitalInvite[]
  registeredDonors Donor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region, town])
  @@map("hospitals")
}

// Blood Bank Profile (extends User)
model BloodBank {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  phone String @unique

  // Location — Cameroon administrative structure
  region        CameroonRegion
  town          String // e.g. "Douala", "Yaoundé", "Bafoussam"
  neighbourhood String? // Quartier e.g. "Akwa", "Bastos"
  address       String? // Street/building detail if available (often informal)

  // Optional precise location
  latitude  Float?
  longitude Float?

  // Official registration
  licenseNumber String? // Numéro d'agrément — issued by Ministère de la Santé Publique

  // v2 fields — persistent profile for blood bank relationship
  contactName        String? // Name of the contact person
  languagePreference String?                    @default("FR") // "FR" | "EN"
  conversationState  BloodBankConversationState @default(IDLE)

  // Relationships
  registeredDonors   Donor[]
  bloodBankResponses BloodBankResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region, town])
  @@map("blood_banks")
}

// Doctor Profile (extends User, belongs to Hospital)
model Doctor {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  name           String
  phone          String  @unique
  specialization String? // e.g., "Cardiology", "Surgery"
  registrationNo String  @unique // Medical council registration

  hospitalInvite   HospitalInvite?
  registeredDonors Donor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId]) // Makes queries faster
  @@map("doctors")
}

// ============================================
// HOSPITAL INVITE SYSTEM
// ============================================

model HospitalInvite {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  doctorEmail String
  status      InviteStatus @default(PENDING)

  // Link to doctor once they register
  doctorId String? @unique
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  invitedBy  String? // User ID of hospital admin who sent invite
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, doctorEmail]) // Prevent duplicate invites
  @@index([hospitalId])
  @@index([doctorEmail])
  @@index([status])
  @@map("hospital_invites")
}

enum InviteStatus {
  PENDING // Invite sent, doctor hasn't registered
  ACCEPTED // Doctor registered and joined hospital
  REJECTED // Doctor explicitly rejected (optional)
  CANCELLED // Hospital cancelled the invite
}

// ============================================
// DONOR SYSTEM (Privacy-Protected)
// ============================================

model Donor {
  id String @id @default(uuid())

  // Registered by
  hospitalId  String?
  hospital    Hospital?  @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  bloodBankId String?
  bloodBank   BloodBank? @relation(fields: [bloodBankId], references: [id], onDelete: SetNull)
  doctorId    String?
  doctor      Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  // Personal Information (NEVER shown in UI)
  name          String
  phone         String         @unique // Primary contact — WhatsApp preferred
  email         String?
  dateBirth     DateTime
  bloodGroup    BloodGroup
  region        CameroonRegion
  town          String
  neighbourhood String?
  genre         Gender

  // v2 fields — persistent profile for personalised outreach
  preferredName      String? // What the donor likes to be called
  languagePreference String?                @default("FR") // "FR" | "EN"
  conversationState  DonorConversationState @default(IDLE)
  onboardingComplete Boolean                @default(false)
  lastDonationDate   DateTime? // Updated after confirmed donation
  healthNotes        String? // Free text — NOT medical diagnosis
  availabilityNotes  String? // e.g. "Not available in December"
  messagesSentCount  Int                    @default(0) // Total outreach messages sent ever
  optOutAt           DateTime? // Set when donor requests removal

  // AI Agent outreach records
  donorResponses DonorResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bloodGroup])
  @@index([region, town])
  @@index([hospitalId])
  @@index([bloodBankId])
  @@map("donors")
}

// ============================================
// BLOOD REQUEST SYSTEM
// ============================================

model BloodRequest {
  id String @id @default(uuid())

  // Who made the request?
  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  // What blood is needed?
  bloodGroup    BloodGroup
  unitsRequired Int
  urgency       RequestUrgency
  status        RequestStatus  @default(PENDING)

  // Patient Information
  patientName   String
  patientAge    Int
  patientGender Gender // ← use your existing enum

  // Location — Cameroon administrative structure
  hospitalName    String
  region          CameroonRegion // ← replaces state
  town            String // ← replaces city
  neighbourhood   String? // Quartier for precise routing
  hospitalAddress String? // Landmark-based, optional
  latitude        Float? // Optional GPS
  longitude       Float? // Optional GPS

  // Medical Details
  requiredBy    DateTime
  medicalReason String?

  // AI Agent Tracking
  aiProcessedAt     DateTime?
  donorsContacted   Int       @default(0)
  willingDonorCount Int       @default(0)
  reportMarkdown    String? // Final Markdown report generated by AI

  notes String?

  // Agent outreach relations
  donorResponses     DonorResponse[]
  bloodBankResponses BloodBankResponse[]
  outreachTasks      OutreachTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([bloodGroup])
  @@index([urgency])
  @@index([requiredBy])
  @@index([region, town])
  @@map("blood_requests")
}

// ============================================
// AGENT OUTREACH RECORDS
// ============================================

// Records each donor's response to an outreach for a specific blood request
model DonorResponse {
  id           String            @id @default(uuid())
  requestId    String
  request      BloodRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donorId      String
  donor        Donor             @relation(fields: [donorId], references: [id], onDelete: Cascade)
  availability DonorAvailability
  constraint   String? // e.g. "only available after 5pm"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, donorId])
  @@index([requestId])
  @@map("donor_responses")
}

// Records each blood bank's availability response for a specific blood request
model BloodBankResponse {
  id                     String       @id @default(uuid())
  requestId              String
  request                BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bloodBankId            String
  bloodBank              BloodBank    @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
  available              Boolean
  unitsAvailable         Int          @default(0)
  preparationTimeMinutes Int          @default(0)
  notes                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, bloodBankId])
  @@index([requestId])
  @@map("blood_bank_responses")
}

// ============================================
// V2 — PHONE NUMBER REGISTRY
// ============================================

// Maps E.164 phone numbers to entities (donors or blood banks)
// Used by WhatsApp webhook to route incoming messages
model PhoneNumberRegistry {
  id         String @id @default(uuid())
  phone      String @unique // E.164 without + (e.g. "237612345678")
  entityType String // "DONOR" | "BLOOD_BANK"
  entityId   String // Foreign key to Donor.id or BloodBank.id

  createdAt DateTime @default(now())

  @@index([phone])
  @@map("phone_number_registry")
}

// ============================================
// V2 — OUTREACH TASK
// ============================================

// Created by Doctor Coordinator when delegating to Donor Coordinator
model OutreachTask {
  id              String             @id @default(uuid())
  requestId       String
  request         BloodRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status          OutreachTaskStatus @default(PENDING)
  donorsContacted Int                @default(0)
  banksContacted  Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([requestId])
  @@map("outreach_tasks")
}
