generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  role          UserRole
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  authProvider  String         @default("local")
  googleId      String?        @unique
  bloodBank     BloodBank?
  bloodRequests BloodRequest[]
  doctor        Doctor?
  hospital      Hospital?
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Hospital {
  id               String           @id @default(uuid())
  userId           String           @unique
  name             String
  address          String?
  phone            String
  latitude         Float?
  longitude        Float?
  licenseNumber    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  neighbourhood    String?
  region           CameroonRegion
  town             String
  doctors          Doctor[]
  registeredDonors Donor[]
  invites          HospitalInvite[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([region, town])
  @@map("hospitals")
}

model BloodBank {
  id                 String              @id @default(uuid())
  userId             String              @unique
  name               String
  address            String?
  phone              String
  latitude           Float?
  longitude          Float?
  licenseNumber      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  neighbourhood      String?
  region             CameroonRegion
  town               String
  bloodBankResponses BloodBankResponse[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredDonors   Donor[]

  @@index([region, town])
  @@map("blood_banks")
}

model Doctor {
  id               String          @id @default(uuid())
  userId           String          @unique
  hospitalId       String
  name             String
  phone            String
  specialization   String?
  registrationNo   String          @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  hospital         Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredDonors Donor[]
  feedbacks        Feedback[]
  hospitalInvite   HospitalInvite?

  @@index([hospitalId])
  @@map("doctors")
}

model HospitalInvite {
  id          String       @id @default(uuid())
  hospitalId  String
  doctorEmail String
  status      InviteStatus @default(PENDING)
  doctorId    String?      @unique
  invitedBy   String?
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  doctor      Doctor?      @relation(fields: [doctorId], references: [id])
  hospital    Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, doctorEmail])
  @@index([hospitalId])
  @@index([doctorEmail])
  @@index([status])
  @@map("hospital_invites")
}

model Donor {
  id             String          @id @default(uuid())
  hospitalId     String?
  bloodBankId    String?
  name           String
  email          String?
  phone          String          @unique
  bloodGroup     BloodGroup
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  dateBirth      DateTime
  genre          Gender
  neighbourhood  String?
  region         CameroonRegion
  town           String
  doctorId       String?
  donorResponses DonorResponse[]
  bloodBank      BloodBank?      @relation(fields: [bloodBankId], references: [id])
  doctor         Doctor?         @relation(fields: [doctorId], references: [id])
  hospital       Hospital?       @relation(fields: [hospitalId], references: [id])

  @@index([bloodGroup])
  @@index([region, town])
  @@index([hospitalId])
  @@index([bloodBankId])
  @@map("donors")
}

model BloodRequest {
  id                 String              @id @default(uuid())
  requesterId        String
  bloodGroup         BloodGroup
  unitsRequired      Int
  urgency            RequestUrgency
  status             RequestStatus       @default(PENDING)
  patientName        String
  patientAge         Int
  hospitalName       String
  hospitalAddress    String?
  latitude           Float?
  longitude          Float?
  requiredBy         DateTime
  medicalReason      String?
  aiProcessedAt      DateTime?
  donorsContacted    Int                 @default(0)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  neighbourhood      String?
  region             CameroonRegion
  town               String
  patientGender      Gender
  willingDonorCount  Int                 @default(0)
  reportMarkdown     String?
  bloodBankResponses BloodBankResponse[]
  requester          User                @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  donorResponses     DonorResponse[]
  feedbacks          Feedback?

  @@index([requesterId])
  @@index([status])
  @@index([bloodGroup])
  @@index([urgency])
  @@index([requiredBy])
  @@index([region, town])
  @@map("blood_requests")
}

model DonorResponse {
  id           String            @id @default(uuid())
  requestId    String
  donorId      String
  availability DonorAvailability
  constraint   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  donor        Donor             @relation(fields: [donorId], references: [id], onDelete: Cascade)
  request      BloodRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorId])
  @@index([requestId])
  @@map("donor_responses")
}

model BloodBankResponse {
  id                     String       @id @default(uuid())
  requestId              String
  bloodBankId            String
  available              Boolean
  unitsAvailable         Int          @default(0)
  preparationTimeMinutes Int          @default(0)
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  bloodBank              BloodBank    @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
  request                BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, bloodBankId])
  @@index([requestId])
  @@map("blood_bank_responses")
}

model Feedback {
  id                   String       @id @default(uuid())
  requestId            String       @unique
  doctorId             String
  responseAccuracy     Int?
  responseSpeed        Int?
  communication        Int?
  overallRating        Int?
  comments             String?
  whatWorked           String?
  whatNeedsImprovement String?
  agentResponseSummary Json?
  status               String       @default("SUBMITTED")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  doctor               Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request              BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([requestId])
  @@index([doctorId])
  @@index([status])
  @@map("feedbacks")
}

model sangroot_agent_memory_conversations {
  id                             String                           @id
  resource_id                    String
  user_id                        String
  title                          String
  metadata                       Json
  created_at                     DateTime                         @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at                     DateTime                         @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  sangroot_agent_memory_messages sangroot_agent_memory_messages[]
  sangroot_agent_memory_steps    sangroot_agent_memory_steps[]

  @@index([resource_id], map: "idx_sangroot_agent_memory_conversations_resource_id")
  @@index([user_id], map: "idx_sangroot_agent_memory_conversations_user_id")
}

model sangroot_agent_memory_messages {
  conversation_id                     String
  message_id                          String
  user_id                             String
  role                                String
  parts                               Json?
  metadata                            Json?
  format_version                      Int?                                @default(2)
  created_at                          DateTime                            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  sangroot_agent_memory_conversations sangroot_agent_memory_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conversation_id, message_id])
  @@index([conversation_id], map: "idx_sangroot_agent_memory_messages_conversation_id")
  @@index([created_at], map: "idx_sangroot_agent_memory_messages_created_at")
}

model sangroot_agent_memory_steps {
  id                                  String                              @id
  conversation_id                     String
  user_id                             String
  agent_id                            String
  agent_name                          String?
  operation_id                        String?
  step_index                          Int
  type                                String
  role                                String
  content                             String?
  arguments                           Json?
  result                              Json?
  usage                               Json?
  sub_agent_id                        String?
  sub_agent_name                      String?
  created_at                          DateTime                            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  sangroot_agent_memory_conversations sangroot_agent_memory_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, step_index], map: "idx_sangroot_agent_memory_steps_conversation")
  @@index([conversation_id, operation_id], map: "idx_sangroot_agent_memory_steps_operation")
}

model sangroot_agent_memory_users {
  id         String   @id
  metadata   Json?
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model sangroot_agent_memory_workflow_states {
  id              String   @id
  workflow_id     String
  workflow_name   String
  status          String
  input           Json?
  context         Json?
  workflow_state  Json?
  suspension      Json?
  events          Json?
  output          Json?
  cancellation    Json?
  user_id         String?
  conversation_id String?
  metadata        Json?
  created_at      DateTime @db.Timestamptz(6)
  updated_at      DateTime @db.Timestamptz(6)

  @@index([status], map: "idx_sangroot_agent_memory_workflow_states_status")
  @@index([workflow_id], map: "idx_sangroot_agent_memory_workflow_states_workflow_id")
}

enum UserRole {
  HOSPITAL
  BLOOD_BANK
  DOCTOR
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Gender {
  MALE
  FEMALE
}

enum CameroonRegion {
  ADAMAWA
  CENTRE
  EAST
  FAR_NORTH
  LITTORAL
  NORTH
  NORTH_WEST
  WEST
  SOUTH
  SOUTH_WEST
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  FULFILLED
  CANCELLED
  EXPIRED
}

enum RequestUrgency {
  CRITICAL
  URGENT
  ROUTINE
}

enum DonorAvailability {
  AVAILABLE
  UNAVAILABLE
  CONDITIONAL
  NO_RESPONSE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// ============================================
// V2 — PHONE NUMBER REGISTRY
// ============================================

// Maps E.164 phone numbers to entities (donors or blood banks)
// Used by WhatsApp webhook to route incoming messages
model PhoneNumberRegistry {
  id         String @id @default(uuid())
  phone      String @unique // E.164 without + (e.g. "237612345678")
  entityType String // "DONOR" | "BLOOD_BANK"
  entityId   String // Foreign key to Donor.id or BloodBank.id

  createdAt DateTime @default(now())

  @@index([phone])
  @@map("phone_number_registry")
}

// ============================================
// V2 — OUTREACH TASK
// ============================================

// Created by Doctor Coordinator when delegating to Donor Coordinator
model OutreachTask {
  id              String             @id @default(uuid())
  requestId       String
  request         BloodRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status          OutreachTaskStatus @default(PENDING)
  donorsContacted Int                @default(0)
  banksContacted  Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([requestId])
  @@map("outreach_tasks")
}
